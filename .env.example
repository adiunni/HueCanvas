MOCK_MODE=true
HUE_BRIDGE_IP=
HUE_APPLICATION_KEY=
# Local bridge HTTPS: false uses just IP + application key, without certificate verification.
# Set true for verified TLS, supplying the bridge ID and trusted CA below.
HUE_TLS_VERIFY=false
HUE_BRIDGE_ID=
HUE_CA_CERT=
APPLE_MUSIC_ENABLED=false

# For fast beat effects: the clientkey from the SAME pairing as HUE_APPLICATION_KEY.
HUE_CLIENT_KEY=
# Optional area UUID; otherwise match exactly the enabled color bulbs.
HUE_ENTERTAINMENT_AREA=
# Optional path to an OpenSSL libssl with DTLS 1.2 PSK support.
HUE_OPENSSL_LIB=
